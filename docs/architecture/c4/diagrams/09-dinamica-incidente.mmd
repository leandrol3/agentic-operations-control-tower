flowchart TB
  %% Complemento · Fluxo dinâmico — Do pedido ao resultado durável
  %% Escopo: Ordem conceitual do caminho HTTP/MCP; at-least-once e idempotência
  submit["Componente<br/>1. Validar request<br/>API ou MCP / Pydantic<br/>Mesmo IncidentCapability"]
  claim["Armazenamento<br/>2. Claim no store<br/>PostgreSQL / chave idempotente<br/>incident + operation + version"]
  publish["Componente<br/>3. Publicar task<br/>Producer -&gt; Redis<br/>Mesmo execution_id"]
  acquire["Componente<br/>4. Receber e adquirir<br/>Celery / advisory lock no store<br/>Evita trabalho concorrente duplicado"]
  graph["Componente<br/>5. Executar workflow<br/>Mesmo LangGraph / estado novo<br/>Etapas e eventos; retry limitado"]
  finish["Armazenamento<br/>6. Persistir resultado<br/>PostgreSQL / FinalResult<br/>completed pode conter degradação"]
  query["Componente<br/>7. Consultar resultado<br/>HTTP ou MCP<br/>Approval pending; sem ação externa"]
  submit -->|"Chamada / SQL"| claim
  claim -->|"Após commit"| publish
  publish -->|"Entrega / redelivery"| acquire
  acquire -->|"Claim aceito"| graph
  graph -->|"Eventos + terminal"| finish
  finish -->|"Consulta posterior"| query
  classDef person fill:#17334f,stroke:#ffffff,color:#ffffff;
  classDef system fill:#075985,stroke:#ffffff,color:#ffffff;
  classDef container fill:#dceef9,stroke:#12334f,color:#12334f;
  classDef component fill:#ddf3ed,stroke:#16463e,color:#16463e;
  classDef store fill:#fff0cf,stroke:#624418,color:#624418;
  classDef external fill:#e5e7eb,stroke:#374151,color:#374151;
  class submit component;
  class claim store;
  class publish component;
  class acquire component;
  class graph component;
  class finish store;
  class query component;
