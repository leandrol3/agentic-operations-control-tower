flowchart TB
  %% C3 · Componentes da API / gestão — Síntese, proposta e conhecimento
  %% Escopo: Mesmo código reutilizado no processo MCP; Compiler/revisão acessados por HTTP
  subgraph scope["Escopo da vista"]
    conv["Componente<br/>Conversations<br/>Python / memória do processo<br/>Contexto e últimas mensagens"]
    maestro["Componente<br/>Maestro + MaestroTools<br/>Python / contexto estruturado<br/>Lê sinais e conhecimento aprovado"]
