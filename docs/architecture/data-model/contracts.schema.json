      "Approval": {
        "additionalProperties": false,
        "properties": {
          "required": {
            "const": true,
            "default": true,
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "const": "pending",
            "default": "pending",
            "title": "Status",
            "type": "string"
          },
          "authority": {
            "enum": [
              "operations_manager",
              "manager"
            ],
            "title": "Authority",
            "type": "string"
          },
          "actions_executed": {
            "const": false,
            "default": false,
            "title": "Actions Executed",
            "type": "boolean"
          }
        },
        "required": [
          "authority"
        ],
        "title": "Approval",
        "type": "object"
      },
      "FinalResult": {
        "additionalProperties": false,
        "properties": {
          "reference_case_id": {
            "const": "INCIDENT-001",
            "default": "INCIDENT-001",
            "title": "Reference Case Id",
            "type": "string"
          },
          "mode": {
            "default": "mock",
            "enum": [
              "mock",
              "openai",
              "degraded"
            ],
            "title": "Mode",
            "type": "string"
          },
          "outcome": {
            "default": "recommendation",
            "enum": [
              "recommendation",
              "degraded_recommendation",
              "human_review_required"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "reason": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/$defs/Recommendation"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "approval": {
            "$ref": "#/$defs/Approval"
          }
        },
        "required": [
          "approval"
        ],
        "title": "FinalResult",
        "type": "object"
      },
      "Recommendation": {
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "title": "Incident Id",
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity",
            "type": "string"
          },
          "recommended_action": {
            "minLength": 1,
            "title": "Recommended Action",
            "type": "string"
          },
          "estimated_cost_brl": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Estimated Cost Brl"
          },
          "avoided_penalty_brl": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
