      },
      "completed_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Completed At"
      },
      "current_step": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Current Step"
      },
      "attempt": {
        "default": 1,
        "minimum": 1,
        "title": "Attempt",
        "type": "integer"
      },
      "worker_id": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
