LLM_MODE=mock
OPENAI_MODEL=gpt-4.1-mini
# Para usar openai, forneça OPENAI_API_KEY no ambiente ou .env ignorado.
# Alternativa: .keys na raiz do checkout (valor simples ou OPENAI_API_KEY=...).
# Arquivo em outra pasta: defina OPENAI_API_KEY_FILE com o caminho explícito.
# OPENAI_API_KEY_FILE=../.keys

# Aula 3: usados pelo runtime API/worker; CLI anterior mantém settings originais.
APP_ENV=local
APP_NAME=control-tower
LOG_LEVEL=INFO
LOG_FORMAT=human
REQUEST_TIMEOUT=3
WORKER_CONCURRENCY=1
VISIBILITY_TIMEOUT=900
OTEL_ENABLED=false
OTEL_SERVICE_NAME=control-tower
# Opcional: base OTLP/HTTP, sem /v1/traces (adicionado pelo exporter).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Runtime fora dos containers; Compose usa nomes internos redis/postgres.
# REDIS_URL=redis://127.0.0.1:16379/2
# DATABASE_URL=postgresql://novacore:novacore_demo_only@127.0.0.1:15432/novacore
# Só no laboratório local (Compose habilita). Nunca em APP_ENV=production.
DEMO_CONTROLS_ENABLED=false
